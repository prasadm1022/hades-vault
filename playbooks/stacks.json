[
  {
    "id": "node",
    "ecosystem": "javascript-typescript",
    "priority": 10,
    "markers": ["package.json"],
    "workspace": { "when": { "any": [ { "json": "package.json", "key": "workspaces" }, { "exists": ["pnpm-workspace.yaml", "lerna.json", "nx.json", "rush.json"] } ] } },
    "variants": [
      { "pm": "pnpm", "inherit": true,
        "when": { "any": [ { "exists": "pnpm-lock.yaml" }, { "json": "package.json", "key": "packageManager", "regex": "^pnpm@" } ] },
        "vars": { "run": "pnpm run", "npx": "pnpm exec", "argsep": "" },
        "commands": { "install": "pnpm install --frozen-lockfile" } },
      { "pm": "bun", "inherit": true,
        "when": { "any": [ { "exists": ["bun.lock", "bun.lockb"] }, { "json": "package.json", "key": "packageManager", "regex": "^bun@" } ] },
        "vars": { "run": "bun run", "npx": "bunx", "argsep": "" },
        "commands": { "install": "bun install --frozen-lockfile" } },
      { "pm": "yarn", "inherit": true,
        "when": { "any": [ { "all": [ { "exists": "yarn.lock" }, { "exists": ".yarnrc.yml" } ] }, { "json": "package.json", "key": "packageManager", "regex": "^yarn@([2-9]|\\d\\d)" } ] },
        "vars": { "run": "yarn run", "npx": "yarn", "argsep": "" },
        "commands": { "install": "yarn install --immutable" } },
      { "pm": "yarn", "inherit": true,
        "when": { "any": [ { "exists": "yarn.lock" }, { "json": "package.json", "key": "packageManager", "regex": "^yarn@" } ] },
        "vars": { "run": "yarn run", "npx": "yarn", "argsep": "" },
        "commands": { "install": "yarn install --frozen-lockfile" } },
      { "pm": "npm", "inherit": true,
        "when": { "exists": ["package-lock.json", "npm-shrinkwrap.json"] },
        "vars": { "run": "npm run", "npx": "npx", "argsep": "-- " },
        "commands": { "install": "npm ci" } },
      { "pm": "npm",
        "vars": { "run": "npm run", "npx": "npx", "argsep": "-- " },
        "commands": { "install": "npm install" } }
    ],
    "commands": {
      "build": [ { "when": { "script": "build" }, "cmd": "{run} build" } ],
      "lint": [
        { "when": { "script": ["lint", "lint:check", "eslint"] }, "cmd": "{run} {script}" },
        { "when": { "any": [ { "exists": ["eslint.config.{js,mjs,cjs,ts,mts,cts}", ".eslintrc{,.js,.cjs,.json,.yml,.yaml}"] }, { "json": "package.json", "key": "eslintConfig" } ] }, "cmd": "{npx} eslint ." },
        { "when": { "exists": "biome.json{,c}" }, "cmd": "{npx} biome lint ." }
      ],
      "types": [ { "when": { "script": ["typecheck", "type-check", "check-types", "types", "tsc"] }, "cmd": "{run} {script}" } ],
      "test": [
        { "when": { "script": "test" }, "cmd": "{run} test" },
        { "when": { "dep": "vitest" }, "cmd": "{npx} vitest run" },
        { "when": { "dep": "jest" }, "cmd": "{npx} jest --ci" }
      ],
      "run": [ { "when": { "script": ["dev", "start", "serve"] }, "cmd": "{run} {script}" } ],
      "format": [
        { "when": { "script": ["format:check", "fmt:check", "prettier:check", "check-format", "format-check", "check:format"] }, "cmd": "{run} {script}" },
        { "when": { "any": [ { "exists": [".prettierrc{,.json,.json5,.yml,.yaml,.toml,.js,.cjs,.mjs,.ts}", "prettier.config.{js,cjs,mjs,ts}"] }, { "json": "package.json", "key": "prettier" }, { "dep": "prettier" } ] }, "cmd": "{npx} prettier --check ." },
        { "when": { "exists": "biome.json{,c}" }, "cmd": "{npx} biome format ." }
      ]
    }
  },
  {
    "id": "typescript",
    "ecosystem": "javascript-typescript",
    "priority": 15,
    "requires": ["node"],
    "markers": ["tsconfig.json"],
    "commands": {
      "types": [ { "when": { "exists": "tsconfig.app.json" }, "cmd": "{npx} tsc --noEmit -p tsconfig.app.json" }, "{npx} tsc --noEmit" ]
    }
  },
  {
    "id": "react",
    "ecosystem": "javascript-typescript",
    "priority": 18,
    "requires": ["node"],
    "content": [ { "dep": "react" } ]
  },
  {
    "id": "vite",
    "ecosystem": "javascript-typescript",
    "priority": 20,
    "requires": ["node"],
    "content": [ { "dep": "vite" }, { "not": { "dep": ["react", "vue", "svelte", "@sveltejs/kit", "nuxt", "astro", "solid-js", "preact"] } } ],
    "commands": { "build": "{npx} vite build", "run": "{npx} vite" }
  },
  {
    "id": "react-vite",
    "ecosystem": "javascript-typescript",
    "priority": 25,
    "requires": ["node"],
    "content": [ { "dep": "react" }, { "dep": "vite" } ],
    "commands": { "build": "{npx} vite build", "run": "{npx} vite" }
  },
  {
    "id": "create-react-app",
    "ecosystem": "javascript-typescript",
    "priority": 25,
    "requires": ["node"],
    "content": [ { "dep": "react-scripts" } ],
    "commands": {
      "build": "{npx} react-scripts build",
      "test": [ { "when": { "script": "test" }, "cmd": "{run} test {argsep}--watchAll=false" }, "{npx} react-scripts test --watchAll=false" ],
      "run": "{npx} react-scripts start"
    }
  },
  {
    "id": "next",
    "ecosystem": "javascript-typescript",
    "priority": 30,
    "requires": ["node"],
    "content": [ { "dep": "next" } ],
    "commands": { "build": "{npx} next build", "run": "{npx} next dev" }
  },
  {
    "id": "vue",
    "ecosystem": "javascript-typescript",
    "priority": 22,
    "requires": ["node"],
    "content": [ { "dep": "vue" } ],
    "commands": {
      "build": [ { "when": { "dep": "vite" }, "cmd": "{npx} vite build" } ],
      "types": [ { "when": { "dep": "vue-tsc" }, "cmd": "{npx} vue-tsc --noEmit" } ],
      "run": [ { "when": { "dep": "vite" }, "cmd": "{npx} vite" } ]
    }
  },
  {
    "id": "nuxt",
    "ecosystem": "javascript-typescript",
    "priority": 30,
    "requires": ["node"],
    "content": [ { "dep": "nuxt" } ],
    "commands": { "build": "{npx} nuxi build", "types": "{npx} nuxi typecheck", "run": "{npx} nuxi dev" }
  },
  {
    "id": "angular",
    "ecosystem": "javascript-typescript",
    "priority": 30,
    "requires": ["node"],
    "markers": ["angular.json"],
    "commands": {
      "build": "{npx} ng build",
      "test": [
        { "when": { "script": "test", "dep": "karma" }, "cmd": "{run} test {argsep}--watch=false --browsers=ChromeHeadless" },
        { "when": { "script": "test" }, "cmd": "{run} test {argsep}--watch=false" },
        { "when": { "dep": "karma" }, "cmd": "{npx} ng test --watch=false --browsers=ChromeHeadless" },
        "{npx} ng test --watch=false"
      ],
      "run": "{npx} ng serve"
    }
  },
  {
    "id": "svelte",
    "ecosystem": "javascript-typescript",
    "priority": 22,
    "requires": ["node"],
    "content": [ { "dep": "svelte" } ],
    "commands": {
      "build": [ { "when": { "dep": "vite" }, "cmd": "{npx} vite build" } ],
      "types": [ { "when": { "script": "check" }, "cmd": "{run} check" }, { "when": { "dep": "svelte-check" }, "cmd": "{npx} svelte-check" } ],
      "run": [ { "when": { "dep": "vite" }, "cmd": "{npx} vite dev" } ]
    }
  },
  {
    "id": "sveltekit",
    "ecosystem": "javascript-typescript",
    "priority": 30,
    "requires": ["node"],
    "content": [ { "dep": "@sveltejs/kit" } ],
    "commands": {
      "build": "{npx} vite build",
      "types": [ { "when": { "script": "check" }, "cmd": "{run} check" }, "{npx} svelte-kit sync && {npx} svelte-check" ],
      "run": "{npx} vite dev"
    }
  },
  {
    "id": "nest",
    "ecosystem": "javascript-typescript",
    "priority": 28,
    "requires": ["node"],
    "content": [ { "dep": "@nestjs/core" } ],
    "commands": {
      "build": "{npx} nest build",
      "run": [ { "when": { "script": "start:dev" }, "cmd": "{run} start:dev" }, "{npx} nest start --watch" ]
    }
  },
  {
    "id": "express",
    "ecosystem": "javascript-typescript",
    "priority": 20,
    "requires": ["node"],
    "content": [ { "dep": "express" } ],
    "commands": { "run": [ { "when": { "exists": ["server.js", "app.js", "index.js", "src/server.js", "src/index.js"] }, "cmd": "node {match}" } ] }
  },
  {
    "id": "astro",
    "ecosystem": "javascript-typescript",
    "priority": 30,
    "requires": ["node"],
    "content": [ { "dep": "astro" } ],
    "commands": {
      "build": "{npx} astro build",
      "types": [ { "when": { "dep": "@astrojs/check" }, "cmd": "{npx} astro check" } ],
      "run": "{npx} astro dev"
    }
  },
  {
    "id": "deno",
    "ecosystem": "javascript-typescript",
    "priority": 12,
    "markers": [["deno.json", "deno.jsonc"]],
    "commands": {
      "install": "deno install",
      "build": [ { "when": { "denoTask": "build" }, "cmd": "deno task build" } ],
      "lint": [ { "when": { "denoTask": "lint" }, "cmd": "deno task lint" }, "deno lint" ],
      "types": [ { "when": { "denoTask": ["check", "typecheck"] }, "cmd": "deno task {script}" }, { "when": { "exists": ["main.ts", "mod.ts"] }, "cmd": "deno check {match}" }, "deno check ." ],
      "test": [ { "when": { "denoTask": "test" }, "cmd": "deno task test" }, { "when": { "exists": ["*{_,.}test.{ts,tsx,js,mjs}", "tests/", "test/"] }, "cmd": "deno test" } ],
      "run": [ { "when": { "denoTask": ["dev", "start"] }, "cmd": "deno task {script}" }, { "when": { "exists": ["main.ts", "main.js"] }, "cmd": "deno run -A {match}" } ],
      "format": [ { "when": { "denoTask": ["fmt:check", "format:check"] }, "cmd": "deno task {script}" }, "deno fmt --check" ]
    }
  },
  {
    "id": "python",
    "ecosystem": "python",
    "priority": 10,
    "markers": [["pyproject.toml", "requirements*.txt", "requirements/", "setup.py", "setup.cfg", "Pipfile", "environment.y{a,}ml"]],
    "workspace": { "when": { "file": "pyproject.toml", "has": "[tool.uv.workspace]" } },
    "variants": [
      { "pm": "uv", "inherit": true,
        "when": { "any": [ { "exists": "uv.lock" }, { "file": "pyproject.toml", "has": "[tool.uv" } ] },
        "vars": { "py": "uv run python", "pyx": "uv run" },
        "commands": { "install": [ { "when": { "exists": "uv.lock" }, "cmd": "uv sync --locked" }, "uv sync" ] } },
      { "pm": "poetry",
        "when": { "any": [ { "exists": "poetry.lock" }, { "file": "pyproject.toml", "has": "[tool.poetry" } ] },
        "vars": { "py": "poetry run python", "pyx": "poetry run" },
        "commands": { "install": "poetry install --no-interaction" } },
      { "pm": "pdm",
        "when": { "any": [ { "exists": "pdm.lock" }, { "file": "pyproject.toml", "has": "[tool.pdm" } ] },
        "vars": { "py": "pdm run python", "pyx": "pdm run" },
        "commands": { "install": "pdm install" } },
      { "pm": "pipenv",
        "when": { "exists": ["Pipfile", "Pipfile.lock"] },
        "vars": { "py": "pipenv run python", "pyx": "pipenv run" },
        "commands": { "install": [ { "when": { "exists": "Pipfile.lock" }, "cmd": "pipenv sync --dev" }, "pipenv install --dev" ] } },
      { "pm": "conda",
        "when": { "exists": "environment.y{a,}ml", "not": { "exists": ["pyproject.toml", "requirements.txt"] } },
        "vars": { "py": "python", "pyx": "python -m" },
        "commands": { "install": [ { "when": { "exists": "environment.y{a,}ml" }, "cmd": "conda env update --file {match} --prune" } ] },
        "note": "conda: commands assume the environment is active" },
      { "pm": "pip",
        "vars": { "py": "{python}", "pyx": "{python} -m" },
        "commands": { "install": [
          { "when": { "all": [ { "exists": "requirements.txt" }, { "exists": "requirements-dev.txt" } ] }, "cmd": "{python} -m pip install -r requirements.txt -r requirements-dev.txt" },
          { "when": { "exists": "requirements.txt" }, "cmd": "{python} -m pip install -r requirements.txt" },
          { "when": { "exists": ["pyproject.toml", "setup.py"] }, "cmd": "{python} -m pip install -e ." }
        ] },
        "note": "pip: run inside a virtualenv (python -m venv .venv)" }
    ],
    "commands": {
      "lint": [
        { "when": { "any": [ { "exists": ["ruff.toml", ".ruff.toml"] }, { "file": "pyproject.toml", "has": "[tool.ruff" }, { "pydep": "ruff" } ] }, "cmd": "{pyx} ruff check ." },
        { "when": { "any": [ { "exists": ".flake8" }, { "file": ["setup.cfg", "tox.ini"], "has": "[flake8]" }, { "pydep": "flake8" } ] }, "cmd": "{pyx} flake8" }
      ],
      "types": [
        { "when": { "any": [ { "exists": ["mypy.ini", ".mypy.ini"] }, { "file": "pyproject.toml", "has": "[tool.mypy" }, { "file": "setup.cfg", "has": "[mypy" }, { "pydep": "mypy" } ] }, "cmd": "{pyx} mypy ." },
        { "when": { "any": [ { "exists": "pyrightconfig.json" }, { "file": "pyproject.toml", "has": "[tool.pyright" }, { "pydep": "pyright" } ] }, "cmd": "{pyx} pyright" }
      ],
      "test": [
        { "when": { "any": [ { "exists": ["pytest.ini", "conftest.py", "tests/conftest.py", "test/conftest.py"] }, { "file": ["pyproject.toml", "setup.cfg", "tox.ini"], "regex": "\\[(tool[:.])?pytest" }, { "pydep": "pytest" } ] }, "cmd": "{pyx} pytest -q" },
        { "when": { "exists": "tests/" }, "cmd": "{py} -m unittest discover -s tests -t ." },
        { "when": { "exists": "test/" }, "cmd": "{py} -m unittest discover -s test -t ." }
      ],
      "run": [ { "when": { "exists": ["main.py", "app.py"] }, "cmd": "{py} {match}" } ],
      "format": [
        { "when": { "any": [ { "file": "pyproject.toml", "has": "[tool.black" }, { "pydep": "black" } ] }, "cmd": "{pyx} black --check ." },
        { "when": { "any": [ { "exists": ["ruff.toml", ".ruff.toml"] }, { "file": "pyproject.toml", "has": "[tool.ruff" } ] }, "cmd": "{pyx} ruff format --check ." }
      ]
    }
  },
  {
    "id": "django",
    "ecosystem": "python",
    "priority": 30,
    "requires": ["python"],
    "markers": ["manage.py"],
    "content": [ { "file": "manage.py", "has": "django" } ],
    "commands": {
      "build": "{py} manage.py check",
      "test": [ { "when": { "pydep": "pytest-django" }, "cmd": "{pyx} pytest -q" }, "{py} manage.py test" ],
      "run": "{py} manage.py runserver"
    }
  },
  {
    "id": "fastapi",
    "ecosystem": "python",
    "priority": 25,
    "requires": ["python"],
    "content": [ { "pydep": "fastapi" } ],
    "commands": {
      "run": [
        { "when": { "exists": "main.py" }, "cmd": "{pyx} uvicorn main:app --reload" },
        { "when": { "exists": "app/main.py" }, "cmd": "{pyx} uvicorn app.main:app --reload" },
        { "when": { "exists": "src/main.py" }, "cmd": "{pyx} uvicorn src.main:app --reload" }
      ]
    }
  },
  {
    "id": "flask",
    "ecosystem": "python",
    "priority": 25,
    "requires": ["python"],
    "content": [ { "pydep": "flask" } ],
    "commands": { "run": "{pyx} flask run" }
  },
  {
    "id": "python-data",
    "ecosystem": "data-ml",
    "priority": 5,
    "requires": ["python"],
    "standalone": false,
    "content": [ { "pydep": ["pandas", "polars", "pyspark", "duckdb", "apache-airflow", "dagster", "prefect"] } ]
  },
  {
    "id": "python-ml",
    "ecosystem": "data-ml",
    "priority": 5,
    "requires": ["python"],
    "standalone": false,
    "content": [ { "pydep": ["torch", "tensorflow", "keras", "jax", "scikit-learn", "xgboost", "lightgbm", "transformers", "langchain", "llama-index", "anthropic", "openai", "mlflow"] } ]
  },
  {
    "id": "jupyter",
    "ecosystem": "data-ml",
    "priority": 5,
    "joins": ["python"],
    "standalone": false,
    "markers": [["*.ipynb", "notebooks/*.ipynb"]]
  },
  {
    "id": "dbt",
    "ecosystem": "data-ml",
    "priority": 20,
    "markers": ["dbt_project.yml"],
    "commands": {
      "install": "dbt deps",
      "build": "dbt parse",
      "lint": [ { "when": { "exists": ".sqlfluff" }, "cmd": "sqlfluff lint" } ],
      "test": "dbt test",
      "run": "dbt build"
    },
    "note": "dbt: needs a profile (profiles.yml or DBT_PROFILES_DIR); test/run hit the warehouse"
  },
  {
    "id": "dvc",
    "ecosystem": "data-ml",
    "priority": 15,
    "aux": true,
    "standalone": false,
    "markers": ["dvc.yaml"],
    "commands": { "run": "dvc repro" }
  },
  {
    "id": "maven",
    "ecosystem": "jvm",
    "priority": 10,
    "markers": ["pom.xml"],
    "workspace": { "when": { "file": "pom.xml", "has": "<modules>" } },
    "variants": [
      { "pm": "maven-wrapper", "when": { "platform": "win32", "exists": "mvnw.cmd" }, "vars": { "mvn": "mvnw.cmd" } },
      { "pm": "maven-wrapper", "when": { "not": { "platform": "win32" }, "exists": "mvnw" }, "vars": { "mvn": "./mvnw" } },
      { "pm": "maven", "vars": { "mvn": "mvn" } }
    ],
    "commands": {
      "build": "{mvn} -B -q -DskipTests package",
      "lint": [
        { "when": { "file": "pom.xml", "has": "maven-checkstyle-plugin" }, "cmd": "{mvn} -B -q checkstyle:check" },
        { "when": { "file": "pom.xml", "has": "maven-pmd-plugin" }, "cmd": "{mvn} -B -q pmd:check" }
      ],
      "test": "{mvn} -B -q test",
      "format": [ { "when": { "file": "pom.xml", "has": "spotless-maven-plugin" }, "cmd": "{mvn} -B -q spotless:check" } ]
    }
  },
  {
    "id": "gradle",
    "ecosystem": "jvm",
    "priority": 10,
    "markers": [["build.gradle", "build.gradle.kts", "settings.gradle", "settings.gradle.kts"]],
    "workspace": { "when": { "file": "settings.gradle{,.kts}", "regex": "^\\s*include" } },
    "variants": [
      { "pm": "gradle-wrapper", "when": { "platform": "win32", "exists": "gradlew.bat" }, "vars": { "gradle": "gradlew.bat" } },
      { "pm": "gradle-wrapper", "when": { "not": { "platform": "win32" }, "exists": "gradlew" }, "vars": { "gradle": "./gradlew" } },
      { "pm": "gradle", "vars": { "gradle": "gradle" } }
    ],
    "commands": {
      "build": "{gradle} assemble --console=plain",
      "lint": [
        { "when": { "file": ["{,*/}build.gradle{,.kts}", "gradle/libs.versions.toml"], "regex": "io\\.gitlab\\.arturbosch\\.detekt|dev\\.detekt" }, "cmd": "{gradle} detekt --console=plain" },
        { "when": { "file": ["{,*/}build.gradle{,.kts}", "gradle/libs.versions.toml"], "has": "org.jlleitschuh.gradle.ktlint" }, "cmd": "{gradle} ktlintCheck --console=plain" },
        { "when": { "file": "{,*/}build.gradle{,.kts}", "regex": "['\"]checkstyle['\"]|^\\s*checkstyle\\s*$" }, "cmd": "{gradle} checkstyleMain --console=plain" },
        { "when": { "file": "{,*/}build.gradle{,.kts}", "regex": "['\"]pmd['\"]|^\\s*pmd\\s*$" }, "cmd": "{gradle} pmdMain --console=plain" }
      ],
      "test": "{gradle} test --console=plain",
      "run": [ { "when": { "file": "{,*/}build.gradle{,.kts}", "regex": "['\"]application['\"]|^\\s*application\\s*(\\{.*)?$" }, "cmd": "{gradle} run --console=plain" } ],
      "format": [ { "when": { "file": ["{,*/}build.gradle{,.kts}", "gradle/libs.versions.toml"], "has": "com.diffplug.spotless" }, "cmd": "{gradle} spotlessCheck --console=plain" } ]
    }
  },
  {
    "id": "kotlin",
    "ecosystem": "jvm",
    "priority": 15,
    "requires": ["gradle", "maven"],
    "content": [ { "file": ["{,*/}build.gradle{,.kts}", "gradle/libs.versions.toml", "pom.xml"], "regex": "org\\.jetbrains\\.kotlin|kotlin\\(\"|kotlin-maven-plugin" } ]
  },
  {
    "id": "spring-boot",
    "ecosystem": "jvm",
    "priority": 25,
    "requires": ["maven", "gradle"],
    "content": [ { "file": ["pom.xml", "{,*/}build.gradle{,.kts}", "gradle/libs.versions.toml"], "has": "spring-boot" } ],
    "commands": {
      "run": [ { "when": { "stack": "maven" }, "cmd": "{mvn} spring-boot:run" }, { "when": { "stack": "gradle" }, "cmd": "{gradle} bootRun --console=plain" } ]
    }
  },
  {
    "id": "scala-sbt",
    "ecosystem": "jvm",
    "priority": 10,
    "markers": ["build.sbt"],
    "commands": {
      "install": "sbt -batch update",
      "build": "sbt -batch compile",
      "test": "sbt -batch test",
      "run": "sbt -batch run",
      "format": [ { "when": { "exists": ".scalafmt.conf" }, "cmd": "sbt -batch scalafmtCheckAll" } ]
    }
  },
  {
    "id": "go",
    "ecosystem": "go",
    "priority": 10,
    "markers": ["go.mod"],
    "workspace": { "when": { "exists": "go.work" } },
    "commands": {
      "install": "go mod download",
      "build": "go build ./...",
      "lint": [ { "when": { "exists": ".golangci.{yml,yaml,toml,json}" }, "cmd": "golangci-lint run" }, "go vet ./..." ],
      "test": "go test ./...",
      "run": [ { "when": { "exists": "main.go" }, "cmd": "go run ." } ],
      "format": "gofmt -l ."
    },
